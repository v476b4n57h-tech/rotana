# Copy this file to .env.local and fill in the values.
# .env.local is listed in .gitignore and must NEVER be committed.
# During development, use a development/test project only, never production.

# Public values (may reach the browser; data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server only (Vercel Environment Variables). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Environment: development | staging | production
APP_ENV=development
