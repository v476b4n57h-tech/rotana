# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en komt NOOIT in git.
# Gebruik tijdens de ontwikkeling alleen een test-/ontwikkelproject, nooit productie.

# Publieke waarden (mogen in de browser terechtkomen; beveiliging gebeurt via RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geheim: alleen op de server (Vercel Environment Variables). Nooit met NEXT_PUBLIC_ beginnen.
SUPABASE_SERVICE_ROLE_KEY=

# Welke omgeving: development | staging | production
APP_ENV=development
